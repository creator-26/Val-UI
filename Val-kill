    Size = UDim2.fromOffset(580, 460),
    Transparent = true,
    Theme = "Dark", 
})

-- ========================================================
-- PESTAÑAS PRINCIPALES (TABS)
-- ========================================================
local MainTab = Window:Tab({
    Title = "Principal",
    -- Sin icono
})

local PlayerTab = Window:Tab({
    Title = "Jugador",
    -- Sin icono
})

local MiscTab = Window:Tab({
    Title = "Otros",
    -- Sin icono
})

local SettingsTab = Window:Tab({
    Title = "Ajustes",
    -- Sin icono
})
 
-- ========================================================
-- ELEMENTOS DE LA PESTAÑA PRINCIPAL (COMBATE)
-- ========================================================
MainTab:Section({ Title = "Combate Principal" })

-- 1. Toggle para Auto Kill Principal
MainTab:Toggle({
    Title = "Auto Kill Principal",
    Desc = "Ataca continuamente a los jugadores válidos",
    Value = State.AutoKillEnabled, -- Usamos el estado guardado de tu JSON
    Callback = function(value)
        State.AutoKillEnabled = value
        
        -- Llamamos a tus funciones originales de la Sección 4
        if value then 
            startAutoKill() 
        else 
            stopAutoKill() 
        end
        
        saveLists() -- Guarda la configuración
    end,
})

-- 2. Toggle para Atacar a Todos (Modo)
MainTab:Toggle({
    Title = "Atacar a Todos",
    Desc = "Ignora al objetivo único y ataca a todo el servidor",
    Value = State.AutoKillAll, -- Usamos tu variable original
    Callback = function(value)
        State.AutoKillAll = value
        saveLists()
    end,
})


  MainTab:Section({ Title = "Selección de Objetivo" })

-- Usamos un Paragraph en lugar de Label para que sea compatible con Val-UI
local TargetInfo = MainTab:Paragraph({
    Title = "Objetivo Actual",
    Content = "Ninguno",
})

local TargetDropdown = MainTab:Dropdown({
    Title = "Seleccionar Jugador",
    Values = getPlayerList(),
    Default = "",
    Callback = function(selected)
        if selected and selected ~= "" and selected ~= "Sin jugadores en el servidor" then
            local username = selected
            if string.find(selected, " | ") then
                username = string.split(selected, " | ")[2]
            end

            State.TargetPlayerName = username
            State.AutoKillAll = false
            TargetInfo:SetDesc("Objetivo: " .. selected)
        end
    end,
})

MainTab:Button({
    Title = "🔄 Refrescar Lista de Jugadores",
    Callback = function()
        TargetDropdown:SetValues(getPlayerList())
    end,
})

MainTab:Button({
    Title = "❌ Quitar Objetivo Seleccionado",
    Callback = function()
        State.TargetPlayerName = ""
        TargetInfo:SetDesc("Ninguno")
        TargetDropdown:SetValues(getPlayerList())
    end,
})


