-- ========================================================
-- CARGA DE LA LIBRERÍA VAL-UI
-- ========================================================
local ValUI = loadstring(game:HttpGet("https://raw.githubusercontent.com/creator-26/Val-UI/main/dist/main.lua"))()



-- Definición de variables de estado que faltaban
local State = {
    AutoKillEnabled = false,
    AutoKillAll = true,
    TargetPlayerName = "",
    Whitelist = {},
    Blacklist = {},
    AtaqueRapido = false,
}

-- ========================================================
-- VENTANA PRINCIPAL
-- ========================================================
local Window = ValUI:CreateWindow({
    Title = "VAL-TOP SUPREMO", 
    Icon = "rbxassetid://96664341802198",
    Author = "phol_268t",
    Folder = "MiScript_Config", 
    Size = UDim2.fromOffset(580, 460),
    Transparent = true,
    Theme = "Dark", 
})

-- ========================================================
-- PESTAÑAS PRINCIPALES (TABS)
-- ========================================================
local MainTab = Window:Tab({
    Title = "Principal",
    -- Sin icono
})

local PlayerTab = Window:Tab({
    Title = "Jugador",
    -- Sin icono
})

local MiscTab = Window:Tab({
    Title = "Otros",
    -- Sin icono
})

local SettingsTab = Window:Tab({
    Title = "Ajustes",
    -- Sin icono
})
 
-- ========================================================
-- ELEMENTOS DE LA PESTAÑA PRINCIPAL (COMBATE)
-- ========================================================
MainTab:Section({ Title = "Combate Principal" })

-- 1. Toggle para Auto Kill Principal
MainTab:Toggle({
    Title = "Auto Kill Principal",
    Desc = "Ataca continuamente a los jugadores válidos",
    Value = State.AutoKillEnabled, -- Usamos el estado guardado de tu JSON
    Callback = function(value)
        State.AutoKillEnabled = value
        
        -- Llamamos a tus funciones originales de la Sección 4
        if value then 
            startAutoKill() 
        else 
            stopAutoKill() 
        end
        
        saveLists() -- Guarda la configuración
    end,
})

-- 2. Toggle para Atacar a Todos (Modo)
MainTab:Toggle({
    Title = "Atacar a Todos",
    Desc = "Ignora al objetivo único y ataca a todo el servidor",
    Value = State.AutoKillAll, -- Usamos tu variable original
    Callback = function(value)
        State.AutoKillAll = value
        saveLists()
    end,
})


-- ========================================================
-- NOTIFICACIÓN DE INICIO
-- ========================================================
ValUI:Notify({
    Title = "Script Cargado",
    Content = "La interfaz se cargó correctamente.",
    Duration = 3,
})

-- Seleccionar la primera pestaña por defecto
Window:SelectTab(1)
