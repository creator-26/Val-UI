-- ========================================================
-- CARGA DE LA LIBRERÍA VAL-UI
-- ========================================================
local ValUI = loadstring(game:HttpGet("https://raw.githubusercontent.com/creator-26/Val-UI/main/dist/main.lua"))()



-- Definición de variables de estado que faltaban
local State = {
    AutoKillEnabled = false,
    AutoKillAll = true,
    TargetPlayerName = "",
    Whitelist = {},
    Blacklist = {},
    AtaqueRapido = false,
}

local function getPlayerList()
    local list = {}
    for _, player in ipairs(game:GetService("Players"):GetPlayers()) do
        if player ~= game:GetService("Players").LocalPlayer then
            local entry = player.DisplayName .. " | " .. player.Name
            table.insert(list, entry)
        end
    end
    if #list == 0 then
        table.insert(list, "Sin jugadores en el servidor")
    end
    return list
end

-- ========================================================
-- VENTANA PRINCIPAL
-- ========================================================
local Window = ValUI:CreateWindow({
    Title = "VAL-TOP SUPREMO", 
    Icon = "rbxassetid://96664341802198",
    Author = "phol_268t",
